# Settings for ollaa-web-scraper. Copy this file to .env (in this folder) and fill in the
# values. .env is never committed. Never put a password anywhere else.

# ── PostgreSQL database ──────────────────────────────────────────
# The same `ollaa` database as Ollaa-Telegram, with the same everyday login: ollaa_user
# (owns the tables, not a superuser). Never use the administrator login postgres here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ollaa
DB_USER=ollaa_user
DB_PASSWORD=

# ── Google Sheets upload (optional; the GitHub automation sets its own) ──
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials.json
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=
